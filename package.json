{
  "name": "@smart-code-solutions/convex-evalbench",
  "version": "0.4.0-alpha.1",
  "description": "Reactive LLM eval, tracing, and regression layer as a Convex component.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Thorben Fohlmeister <thorben@fohlmeister.com>",
  "homepage": "https://github.com/smart-code-solutions/convex-evalbench#readme",
  "bugs": {
    "url": "https://github.com/smart-code-solutions/convex-evalbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-code-solutions/convex-evalbench.git"
  },
  "packageManager": "pnpm@10.30.0",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/setup.test.ts",
    "patches"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./agent": {
      "types": "./dist/client/agent.d.ts",
      "default": "./dist/client/agent.js"
    },
    "./ai": {
      "types": "./dist/client/ai.d.ts",
      "default": "./dist/client/ai.js"
    },
    "./otlp": {
      "types": "./dist/client/otlp.d.ts",
      "default": "./dist/client/otlp.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "local:start": "node scripts/local-convex.mjs",
    "dev:dashboard": "pnpm --filter convex-evalbench-dashboard dev",
    "build:dashboard": "pnpm --filter convex-evalbench-dashboard build",
    "check:dashboard": "pnpm --filter convex-evalbench-dashboard check",
    "convex:codegen": "convex codegen --component-dir ./src/component && convex codegen",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'pnpm run build:codegen' --initial",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && pnpm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example/convex",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "check": "pnpm run build:codegen && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run check:dashboard",
    "preversion": "pnpm install --frozen-lockfile && pnpm run build:clean && pnpm run test && pnpm run typecheck && pnpm run lint",
    "version": "prettier -w CHANGELOG.md && git add CHANGELOG.md",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "convex",
    "convex-component",
    "llm",
    "eval",
    "evals",
    "tracing",
    "observability",
    "llm-as-judge",
    "ai"
  ],
  "peerDependencies": {
    "@convex-dev/agent": "^0.6.1 || ^0.7.0",
    "ai": "^6.0.0 || ^7.0.0",
    "convex": "^1.46.0"
  },
  "peerDependenciesMeta": {
    "@convex-dev/agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@convex-dev/agent": "^0.7.8",
    "@convex-dev/ai-budget": "1.1.2",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "ai": "^7.0.154",
    "ai-sdk-v6": "npm:ai@^6.0.316",
    "chokidar-cli": "3.0.0",
    "convex": "^1.48.0",
    "convex-test": "^0.0.65",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "convex-helpers": "^0.1.129"
  },
  "engines": {
    "node": ">=22"
  },
  "contributors": [
    "Smart Code Solutions"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
